# RICO_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_MODEL=kr/claude-sonnet-4.5

# Agnes 3.0 Flash (Sapiens AI OpenAI 兼容接口)；设置 AGNES_API_KEY 后即可在 TUI 中切换到 agnes。
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash
# 首次迁移可临时取消注释，运行 `rico auth import` 后再删除：
# MINIMAX_API_KEY=your-minimax-api-key
# ROUTER_API_KEY=your-9router-api-key
# AGNES_API_KEY=your-agnes-api-key
# EXA_API_KEY=your-exa-api-key
# AGENT_MAX_STEPS=20 # 默认无轮数限制；取消注释可设正整数限制单次任务最大轮数
RICO_COMPACT_TOKENS=200000
RICO_KEEP_RECENT_TOKENS=20000
